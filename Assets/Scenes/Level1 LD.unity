  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9e18ae88e95e127449de00ba74c4b0c0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ReadMeToBakeNavMech
  _DocString: "Pour bake le NavMech rendez-vous dans l'objet NavMesh en question
    \n\nMais avant de cliquer sur \"Bake\" faites les etapes suivantes :\n\nAllez
    sur \"Personnage\" et d\xE9sactiv\xE9 le \npuis aussi \"Objet\" \npuis \"Trap\"
    (si vous souhaitez que l'IA esquive les pi\xE8ges) \n\nPuis activ\xE9 \"InvisibleWallNavMech\"\n\nPuis
    \"Bake\" le NavMesh\n\nPuis r\xE9activer ou redesactiver tout les objets modifi\xE9\n(Personnage,
    Objet, Trap, InvisibleWallNavMech,...)"
